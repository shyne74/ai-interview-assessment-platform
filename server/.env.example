PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_app_database
JWT_SECRET=your_jwt_secret_here
FASTAPI_KEY=your_fastapi_key_here
GROQ_API_KEY=your_groq_api_key_here
FASTAPI_URL=http://127.0.0.1:8000

# Frontend Base URL (used in candidate invitation email links)
# In production, must be your deployed public URL (e.g. https://assess.yourcompany.com).
# Cannot be localhost in production.
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# COMPANY EXAM MODE - EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# Choose your email provider: 'smtp', 'ethereal', or 'resend'
#
# 1. 'ethereal': Zero-config developer test mode. Creates an isolated test mailbox.
#    Emails are simulated; web preview URLs are generated for each email in tracking.
#
# 2. 'smtp': Standard SMTP delivery (Gmail App Password, SendGrid, Outlook, Brevo).
#
# 3. 'resend': High-deliverability transactional email via Resend HTTP API.
# ==============================================================================

MAIL_PROVIDER=smtp
MAIL_DRY_RUN=false
MAIL_FROM="AI Assess <examiner@assess.ai>"

# --- OPTION A: SMTP Configuration (Default when MAIL_PROVIDER=smtp) ---
# For Gmail: generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=examiner@yourcompany.com
SMTP_PASS=your_16_char_app_password

# --- OPTION B: Resend Configuration (Required when MAIL_PROVIDER=resend) ---
# Sign up at resend.com, add domain, and grab an API key
RESEND_API_KEY=re_your_api_key_here
